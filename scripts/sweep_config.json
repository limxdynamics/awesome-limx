    "arxiv": {
      "enabled": true,
      "max_results": 100,
      "queries": [
        "all:LimX AND cat:cs.RO",
        "all:\"TRON 1\"",
        "all:\"TRON 2\"",
        "all:\"LimX Oli\""
      ],
      "_note": "Checked 2026-11-11: all:LimX 8 hits in total (one is a 2010 maths paper matching 'lim x', hence cat:cs.RO), \"TRON 1\" 1, \"LimX Oli\" 5, \"TRON 2\" 0 for now. \"Tron1\", TRON1 and \"sole-foot\" have none, and generic terms such as \"point-foot\" or \"wheel-foot\" only bring other companies' robots (0 overlap with LimX), so they are left out. arXiv only indexes titles and abstracts: OpenAlex full text is the main paper source.",
      "max_minutes": 10
    },
    "openalex": {
      "enabled": true,
      "max_results": 200,
      "default_days": 365,
      "mailto": "opensource@limxdynamics.com",
